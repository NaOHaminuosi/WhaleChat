# 本地路径
local.properties

# 签名口令 +（可选的）预置 API Key，绝对不进版本库
keystore.properties
keystore/
*.jks
*.keystore

# 构建产物与缓存
build/
.gradle/
.kotlin/
*.apk
*.aab
*.iml
.idea/

# 本地调试产物：uiautomator dump、截图、打包脚本
_probe/
_shots/
captures/
dist/

# 改动前的源码备份（后悔药用，里面是清理前的旧版本号/旧名，绝不能进库）
app_src_backup_*.zip

# 内部交接文档（版本史 / 内部规划），绝不能公开
docs/handover/

# 编辑器 / Office 临时文件（Word 打开 .md 会生成 ~$ 锁文件）
~$*
*.tmp
*.swp
